# Stock & ETF Explorer — Environment Configuration
# Copy this file to .env and fill in your values

# Claude API Key (get from https://console.anthropic.com/settings/keys)
# Required for AI-powered stock analysis and recommendations
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama URL (optional — fallback if Claude API is unavailable)
# Install Ollama from https://ollama.ai and run: ollama pull llama3
OLLAMA_URL=http://localhost:11434

# Database URL (default: SQLite)
DATABASE_URL=sqlite:///./gdf12.db

# Debug mode
DEBUG=false
