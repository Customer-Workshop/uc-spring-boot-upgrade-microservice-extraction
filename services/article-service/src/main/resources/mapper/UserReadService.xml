<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="io.spring.articleservice.repository.UserReadService">
    <select id="findById" resultType="io.spring.articleservice.domain.User">
        select id, username, email, password, bio, image from users where id = #{id}
    </select>
</mapper>
