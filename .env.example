# ============================================================
# Environment variables for docker-compose
# Copy to .env and fill in values before running docker-compose up
# ============================================================

# Shared JWT secret — MUST be the same across all backend services
JWT_SECRET=your-secret-key-change-me-in-production

# Service ports (defaults used in docker-compose.yml)
USER_SERVICE_PORT=8081
ARTICLE_SERVICE_PORT=8082
COMMENT_SERVICE_PORT=8083
FAVORITE_SERVICE_PORT=8084
FRONTEND_PORT=3000
GATEWAY_PORT=80

# Frontend API URL (used by Next.js at build time)
NEXT_PUBLIC_API_URL=http://localhost/api
