<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="io.spring.infrastructure.mybatis.mapper.TagMapper">

    <resultMap id="tag" type="io.spring.core.article.Tag">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO tags (id, name, created_at)
        VALUES (#{tag.id}, #{tag.name}, #{tag.createdAt})
    </insert>

    <select id="findById" resultMap="tag">
        SELECT id, name, created_at FROM tags WHERE id = #{id}
    </select>

    <select id="findByName" resultMap="tag">
        SELECT id, name, created_at FROM tags WHERE name = #{name}
    </select>

    <select id="findAll" resultMap="tag">
        SELECT id, name, created_at FROM tags ORDER BY name
    </select>

    <update id="update">
        UPDATE tags SET name = #{tag.name} WHERE id = #{tag.id}
    </update>

    <delete id="delete">
        DELETE FROM tags WHERE id = #{id}
    </delete>

    <delete id="deleteArticleTagsByTagId">
        DELETE FROM article_tags WHERE tag_id = #{tagId}
    </delete>
</mapper>
