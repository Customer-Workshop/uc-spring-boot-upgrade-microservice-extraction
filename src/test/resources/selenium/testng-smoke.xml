<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium Smoke Test Suite">
    
    <test name="Setup Verification">
        <classes>
            <class name="io.spring.selenium.tests.SeleniumSetupTest"/>
        </classes>
    </test>

    <test name="Home Page Tests">
        <classes>
            <class name="io.spring.selenium.tests.HomePageTest"/>
        </classes>
    </test>

    <test name="Login Page Tests">
        <classes>
            <class name="io.spring.selenium.tests.LoginPageTest"/>
        </classes>
    </test>

    <test name="Register Page Tests">
        <classes>
            <class name="io.spring.selenium.tests.RegisterPageTest"/>
        </classes>
    </test>

    <test name="Navigation Tests">
        <classes>
            <class name="io.spring.selenium.tests.NavigationTest"/>
        </classes>
    </test>

    <test name="User Registration Flow Tests">
        <classes>
            <class name="io.spring.selenium.tests.UserRegistrationFlowTest"/>
        </classes>
    </test>

    <test name="Article CRUD Tests">
        <classes>
            <class name="io.spring.selenium.tests.ArticleCRUDTest"/>
        </classes>
    </test>

    <test name="Article Interaction Tests">
        <classes>
            <class name="io.spring.selenium.tests.ArticleInteractionTest"/>
        </classes>
    </test>
    
</suite>
