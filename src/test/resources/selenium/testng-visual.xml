<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Visual Regression Suite">
    <listeners>
        <listener class-name="io.spring.selenium.listeners.TestListener"/>
    </listeners>
    <test name="Visual Regression Tests">
        <groups>
            <run>
                <include name="visual"/>
            </run>
        </groups>
        <packages>
            <package name="io.spring.selenium.tests.*"/>
        </packages>
    </test>
</suite>
