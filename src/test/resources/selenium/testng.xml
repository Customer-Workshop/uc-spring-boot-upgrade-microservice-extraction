<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium Full Test Suite" parallel="classes" thread-count="2">
    
    <listeners>
        <listener class-name="io.spring.selenium.listeners.TestListener"/>
    </listeners>
    
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="io.spring.selenium.tests.*"/>
        </packages>
    </test>
    
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="io.spring.selenium.tests.*"/>
        </packages>
    </test>
    
    <test name="All Tests">
        <classes>
            <class name="io.spring.selenium.tests.SeleniumSetupTest"/>
            <class name="io.spring.selenium.tests.HomePageTest"/>
            <class name="io.spring.selenium.tests.LoginPageTest"/>
            <class name="io.spring.selenium.tests.RegisterPageTest"/>
            <class name="io.spring.selenium.tests.NavigationTest"/>
            <class name="io.spring.selenium.tests.UserRegistrationFlowTest"/>
            <class name="io.spring.selenium.tests.ArticleCRUDTest"/>
            <class name="io.spring.selenium.tests.ArticleInteractionTest"/>
        </classes>
    </test>
    
</suite>
