# Multi-stage Dockerfile for Spring Boot microservices
# Usage: docker build --build-arg SERVICE_PORT=8081 -f Dockerfile.spring-boot .

# ---- Stage 1: Build ----
FROM gradle:7.4-jdk11 AS builder

WORKDIR /app

# Copy gradle wrapper and build files first for better caching
COPY build.gradle settings.gradle ./
COPY gradle ./gradle
COPY gradlew ./
RUN chmod +x gradlew

# Download dependencies (cached unless build files change)
RUN ./gradlew dependencies --no-daemon || true

# Copy source code
COPY src ./src

# Build the application
RUN ./gradlew bootJar --no-daemon -x test

# ---- Stage 2: Run ----
FROM openjdk:11-jre-slim

ARG SERVICE_PORT=8080

WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Copy built JAR from builder stage
COPY --from=builder /app/build/libs/*.jar app.jar

# Create data directory for SQLite
RUN mkdir -p /data

ENV SERVER_PORT=${SERVICE_PORT}

EXPOSE ${SERVICE_PORT}

HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=30s \
    CMD curl -f http://localhost:${SERVICE_PORT}/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
