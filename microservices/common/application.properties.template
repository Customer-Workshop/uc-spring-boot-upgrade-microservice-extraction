# ============================================================
# Shared application.properties template for microservices
# Copy to each service's src/main/resources/application.properties
# and adjust service-specific values.
# ============================================================

# ---- Server ----
server.port=${SERVER_PORT:8080}

# ---- SQLite Datasource ----
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:sqlite:dev.db}
spring.datasource.driver-class-name=org.sqlite.JDBC

# ---- MyBatis ----
mybatis.configuration.map-underscore-to-camel-case=true
mybatis.configuration.default-fetch-size=100
mybatis.configuration.default-statement-timeout=30
mybatis.mapper-locations=classpath:mapper/*.xml

# ---- Flyway ----
spring.flyway.enabled=true

# ---- JWT ----
jwt.secret=${JWT_SECRET:default-secret-change-me}
jwt.sessionTime=86400

# ---- Actuator ----
management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=always

# ---- Jackson ----
spring.jackson.deserialization.UNWRAP_ROOT_VALUE=true

# ---- Logging ----
logging.level.root=INFO
logging.level.io.spring=DEBUG
