# =============================================================
# NIFTY 500 Stock Screener — Environment Variables
# =============================================================
# Copy this file to .env and fill in the values.
# If API keys are left empty, the app runs with MOCK DATA.

# Database
DATABASE_URL=postgresql://screener:screener@localhost:5432/nifty500

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT (change in production!)
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Keys (optional — leave empty for mock data)
ALPHA_VANTAGE_API_KEY=
INDIAN_API_KEY=

# Scoring Weights (sum should be ~1.0)
WEIGHT_FUNDAMENTALS=0.35
WEIGHT_VALUATION=0.20
WEIGHT_TECHNICAL=0.25
WEIGHT_PATTERNS=0.10
WEIGHT_INSIDER_NEWS=0.10

# Hard Filter Thresholds
MIN_AVG_DAILY_VALUE=10000000
MAX_DEBT_EQUITY=3.0
MAX_PROMOTER_PLEDGE_PCT=50.0
MIN_DATA_COMPLETENESS=0.6

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
